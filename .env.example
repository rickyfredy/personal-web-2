# ===========================
# Personal Web - Environment
# ===========================

# Google Gemini API Key (get yours at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model (default: gemini-2.5-flash-lite)
LLM_MODEL=gemini-2.5-flash-lite

# Frontend port (Next.js dev server)
FRONTEND_PORT=3000

# Backend port (Express RAG server)
BACKEND_PORT=4000

# Backend URL (used by frontend to call RAG API)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Production frontend URL (for CORS on backend)
FRONTEND_URL=https://rfportfolio.online
